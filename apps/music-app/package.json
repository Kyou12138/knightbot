    "expo-status-bar": "latest",
    "react": "latest",
    "react-native": "latest",
    "react-native-safe-area-context": "latest",
    "react-native-web": "latest"
  },
  "devDependencies": {
    "@babel/core": "latest",
    "@playwright/test": "latest",
    "@types/react": "latest",
    "@types/react-native": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
