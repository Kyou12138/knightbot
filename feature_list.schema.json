{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/feature-list.schema.json",
  "title": "FeatureList",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "features"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "priority",
          "platforms",
          "category",
          "description",
          "acceptance_criteria",
          "tests",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-\\d{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "ios",
                "android",
                "web",
                "desktop",
                "backend"
              ]
            }
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 8
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 8
            }
          },
          "tests": {
            "type": "object",
            "required": [
              "unit",
              "integration",
              "e2e"
            ],
            "properties": {
              "unit": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "integration": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "e2e": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^F-\\d{3}$"
            },
            "default": []
          },
          "status": {
            "type": "object",
            "required": [
              "passes",
              "last_verified_at",
              "evidence"
            ],
            "properties": {
              "passes": {
                "type": "boolean"
              },
              "last_verified_at": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

